{
  "whatsapp": {
    "enabled": true,
    "authDir": "./storage/auth",
    "browserName": "WhatsApp Bot"
  },

  "telegram": {
    "enabled": false,
    "botToken": "",
    "pollIntervalMs": 1000
  },

  "owner": {
    "number": "",
    "treatAsAllowedEverywhere": true,
    "timezone": "UTC"
  },

  "triggers": {
    "aliases": ["heyamigo", "amigo", "claude", "clawd", "grok", "codex", "gemini", "google", "xai"],
    "replyToBotCounts": true
  },

  "commands": {
    "prefix": "/",
    "reset": ["reset", "clear", "new"],
    "status": ["status", "info"],
    "reload": ["reload"]
  },

  "ai": {
    "provider": "claude"
  },

  "audio": {
    "transcription": {
      "enabled": true
    }
  },

  "voice": {
    "enabled": false,
    "provider": "elevenlabs",
    "apiKeyEnv": "ELEVENLABS_API_KEY",
    "voiceId": "",
    "modelId": "eleven_multilingual_v2",
    "outputFormat": "mp3_44100_128",
    "maxChars": 1200,
    "timeoutMs": 30000
  },

  "claude": {
    "model": "claude-opus-4-7",
    "personalityFile": "./config/personalities/unfiltered-realist.md",
    "addDirs": ["./config/knowledge"],
    "outputFormat": "json",
    "contextWindow": 200000
  },

  "codex": {
    "model": "gpt-5.6-sol",
    "reasoningEffort": "xhigh",
    "contextWindow": 200000,
    "yolo": true,
    "skipGitRepoCheck": true,
    "extraArgs": []
  },

  "browser": {
    "maxWorkers": 3,
    "cdpUrl": "http://127.0.0.1:9222",
    "connectTimeoutMs": 3000,
    "unavailableRetryMs": 30000,
    "chromeBinary": "auto",
    "display": ":99",
    "startUrl": "about:blank",
    "logFile": "./storage/logs/chrome.log"
  },

  "grok": {
    "bin": "grok",
    "contextWindow": 1000000,
    "alwaysApprove": true,
    "memory": false,
    "extraArgs": []
  },

  "gemini": {
    "bin": "gemini",
    "model": "gemini-3.6-flash",
    "contextWindow": 1000000,
    "extraArgs": []
  },

  "bootstrap": {
    "historyDepth": 50,
    "includeHistory": true,
    "includeChatMetadata": true,
    "recentContextDepth": 3
  },

  "reply": {
    "quoteInGroups": true,
    "chunkChars": 3500,
    "chunkDelayMs": 800,
    "typingIndicator": true,
    "errorMessage": "Could not process that, please try again.",
    "maxMessageAgeMs": 10800000,
    "showStats": true
  },

  "storage": {
    "messagesDir": "./storage/messages",
    "sessionsFile": "./storage/sessions.json",
    "mediaDir": "./storage/media",
    "mediaRetentionDays": 7
  },

  "memory": {
    "dir": "./storage/memory",
    "instructionsFile": "./config/memory-instructions.md",
    "importInstructionsFile": "./config/import-instructions.md",
    "importPermissionMode": "acceptEdits",
    "digestDebounceMs": 120000,
    "sweepIntervalMs": 10800000,
    "sweepMinNewMessages": 5,
    "maxHistoryForDigest": 100
  },

  "logging": {
    "level": "info",
    "promptRetentionDays": 3
  }
}
